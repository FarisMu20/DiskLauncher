{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Launcher",
  "version": "1.0.0",
  "identifier": "com.faris.disklauncher",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Disk Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 520,
        "backgroundColor": "#e9ebef"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
